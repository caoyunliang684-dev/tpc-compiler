int main(void) {
    int x ;
    x = 0;
    putint(!0);     //  1
    putint(!1);     //  0
    putint(!42);    //  0
    putint(!-1);    //  0
    putint(!'A');   //  0
    putint(!'\0');  //  1


    if (!x) {
        putint(100);  // 100
    }

    while (!1) {
        putint(999);  // don't execute
    }

    return 0;
}
