int main(void) {
    putint(1 + 2);      // 3
    putint(5 - 3);      // 2
    putint(4 * 2);      // 8
    putint(10 / 2);     // 5
    putint(10 % 3);     // 1

    putint(+42);        // 42
    putint(-42);        // -42

    putint(3 == 3);     // 1
    putint(3 != 4);     // 1
    putint(2 < 3);      // 1
    putint(3 <= 3);     // 1
    putint(4 > 2);      // 1
    putint(4 >= 4);     // 1
    putint(4 == 5);     // 0
    putint(4 != 4);     // 0
    putint(2 > 3);      // 0

    putint(!0);         // 1
    putint(!5);         // 0
    putint(1 && 1);     // 1
    putint(0 && 1);     // 0
    putint(1 || 0);     // 1
    putint(0 || 0);     // 0

    putint((3 + 2) * 2 == 10);  // 1
    putint((1 || 0) && (0 == 0)); // 1

    return 0;
}
